{
    "name": "salaab/sgh",
    "version": "1.0.0",
    "description": "Sistema Hospitalar para Fim do Curso",
    "type": "public",
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "core\\":"core/",
            "tests\\":"Tests/"
            
        },
        "files":[
           "app/helpers/utils.php"           
        ]
    },
    "authors": [
        {
            "name": "Abraao Sala",
            "email": "abraaosala@hotmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "tecnickcom/tcpdf": "^6.7",
        "symfony/var-dumper": "^7.2",
        "monolog/monolog": "^3.9",
        "illuminate/database": "^12.22",
        "illuminate/pagination": "^12.22",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpspreadsheet": "^5.1",
        "illuminate/validation": "^12.43",
        "illuminate/translation": "^12.43",
        "illuminate/filesystem": "^12.43",
        "eftec/bladeone": "^4.19"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "pestphp/pest": "^4.2",
        "rector/rector": "^2.2",
        "robmorgan/phinx": "^0.16.10",
        "fakerphp/faker": "^1.24"
       
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
